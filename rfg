#!/usr/bin/env bash
# ============================================================
#  REDFORGE — self-installer + launcher
#  Usage:
#     chmod +x rfg
#     ./rfg          # install + start
#     ./rfg stop     # stop server + tunnel
#     ./rfg status   # show status
#     ./rfg restart  # stop + start
#  Lab-only. Run on an isolated network with consent.
# ============================================================

set -e

# ---------- Colors ----------
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; B='\033[0;36m'; D='\033[0m'
BOLD='\033[1m'

step()  { echo -e "${B}${BOLD}[*]${D} $*"; }
ok()    { echo -e "${G}[✓]${D} $*"; }
warn()  { echo -e "${Y}[!]${D} $*"; }
fail()  { echo -e "${R}[✗]${D} $*"; }

banner() {
  echo -e "${R}"
  cat << 'EOF'
  ██████╗ ███████╗██████╗ ███████╗ ██████╗ ██████╗  ██████╗ ███████╗
  ██╔══██╗██╔════╝██╔══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝ ██╔════╝
  ██████╔╝█████╗  ██║  ██║█████╗  ██║   ██║██████╔╝██║  ███╗█████╗
  ██╔══██╗██╔══╝  ██║  ██║██╔══╝  ██║   ██║██╔══██╗██║   ██║██╔══╝
  ██║  ██║███████╗██████╔╝██║     ╚██████╔╝██║  ██║╚██████╔╝███████╗
  ╚═╝  ╚═╝╚══════╝╚═════╝ ╚═╝      ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝
             Red Team Simulation Lab — Lab-only C2
EOF
  echo -e "${D}"
  echo -e "${Y}  ⚠  Use only on lab VMs you own or have written authorization to test.${D}"
  echo ""
}

# ============================================================
#  SUBCOMMANDS — checked FIRST, before any install logic
# ============================================================

stop_all() {
  step "Stopping REDFORGE..."
  if [ -f logs/server.pid ]; then
    kill "$(cat logs/server.pid)" 2>/dev/null && ok "Server stopped." || warn "Server not running."
    rm -f logs/server.pid
  else
    warn "No server.pid — nothing to stop."
  fi
  if [ -f logs/tunnel.pid ]; then
    kill "$(cat logs/tunnel.pid)" 2>/dev/null && ok "Tunnel stopped." || warn "Tunnel not running."
    rm -f logs/tunnel.pid
  else
    warn "No tunnel.pid — nothing to stop."
  fi
  # Extra safety: kill anything still bound to 8888
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 8888/tcp 2>/dev/null || true
  fi
}

show_status() {
  echo ""
  step "REDFORGE status"
  if [ -f logs/server.pid ] && kill -0 "$(cat logs/server.pid)" 2>/dev/null; then
    ok "Server PID $(cat logs/server.pid) — running"
  else
    warn "Server not running"
  fi
  if [ -f logs/tunnel.pid ] && kill -0 "$(cat logs/tunnel.pid)" 2>/dev/null; then
    ok "Tunnel PID $(cat logs/tunnel.pid) — running"
    grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' logs/tunnel.log 2>/dev/null | head -1
  else
    warn "Tunnel not running"
  fi
}

case "$1" in
  stop)
    stop_all
    exit 0
    ;;
  status)
    show_status
    exit 0
    ;;
  restart)
    stop_all
    sleep 1
    # fall through to install/start logic below
    ;;
esac

# ============================================================
#  INSTALL + LAUNCH
# ============================================================

banner

read -p "Do you confirm this is being installed for lab-only use? (yes/no): " CONSENT
if [ "$CONSENT" != "yes" ]; then
  fail "Consent not given. Exiting."
  exit 1
fi

# ---------- 1. Environment ----------
step "Detecting environment..."
OS="$(uname -s)"
ARCH="$(uname -m)"
if [ "$OS" != "Linux" ]; then
  fail "Linux only. Detected: $OS"
  exit 1
fi
ok "OS: Linux | Arch: $ARCH"

# ---------- 2. Privileges ----------
step "Checking privileges..."
SUDO=""
if [ "$(id -u)" != "0" ]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
    sudo -v || { fail "sudo failed"; exit 1; }
    ok "Using sudo."
  else
    warn "No sudo — system installs will be skipped."
  fi
else
  ok "Running as root."
fi

# ---------- 3. System packages ----------
step "Installing system packages..."
if command -v apt-get >/dev/null 2>&1; then
  $SUDO apt-get update -y >/dev/null 2>&1 || true
  $SUDO apt-get install -y python3 python3-pip nmap whois dnsutils curl wget >/dev/null 2>&1 || \
    warn "Some system packages failed — continuing."
  ok "System packages ready."
elif command -v dnf >/dev/null 2>&1; then
  $SUDO dnf install -y python3 python3-pip nmap whois bind-utils curl wget >/dev/null 2>&1 || true
  ok "System packages ready (dnf)."
else
  warn "Unknown package manager — skipping."
fi

# ---------- 4. Python packages ----------
step "Installing Python packages..."
pip3 install --quiet flask 2>/dev/null || pip3 install --quiet --break-system-packages flask 2>/dev/null || \
  warn "pip install failed — try manually: pip3 install flask"
python3 -c "import flask" 2>/dev/null && ok "Flask installed." || warn "Flask import failed."

# ---------- 5. cloudflared ----------
step "Checking for cloudflared..."
if command -v cloudflared >/dev/null 2>&1; then
  ok "cloudflared already installed ($(cloudflared --version 2>&1 | head -1))"
else
  step "Downloading cloudflared..."
  case "$ARCH" in
    x86_64)  CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64" ;;
    aarch64) CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64" ;;
    armv7l)  CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm" ;;
    *)       fail "Unsupported arch: $ARCH"; exit 1 ;;
  esac
  curl -fsSL "$CF_URL" -o /tmp/cloudflared
  chmod +x /tmp/cloudflared
  $SUDO mv /tmp/cloudflared /usr/local/bin/cloudflared
  ok "cloudflared installed: $(cloudflared --version 2>&1 | head -1)"
fi

# ---------- 6. Metasploit check ----------
if command -v msfconsole >/dev/null 2>&1 && command -v msfvenom >/dev/null 2>&1; then
  ok "Metasploit already installed."
else
  warn "Metasploit not detected — install later: sudo apt install metasploit-framework"
fi

# ---------- 7. Project files ----------
step "Verifying project files..."
REQUIRED_FILES=(
  "server.py"
  "abilities.json"
  "payload.ps1"
  "requirements.txt"
  "templates/dashboard.html"
  "static/style.css"
  "static/app.js"
  "tunnel.py"
  "deployer.py"
  "redteam_api.py"
  "payload_builder.py"
)
MISSING=0
for f in "${REQUIRED_FILES[@]}"; do
  if [ ! -f "$f" ]; then
    fail "Missing: $f"
    MISSING=1
  fi
done
if [ "$MISSING" = "1" ]; then
  fail "Some files are missing. Put the full project in this directory."
  exit 1
fi
ok "All project files present."

# ---------- 8. Runtime dirs ----------
mkdir -p generated_payloads logs
ok "Runtime directories ready."

# ---------- 9. Port 8888 cleanup ----------
step "Checking port 8888..."
if command -v ss >/dev/null 2>&1; then
  if ss -tlnp 2>/dev/null | grep -q ":8888 "; then
    warn "Port 8888 is in use:"
    ss -tlnp 2>/dev/null | grep ":8888 " || true
    read -p "Kill the process holding 8888 and continue? (yes/no): " KILL8K
    if [ "$KILL8K" = "yes" ]; then
      if command -v fuser >/dev/null 2>&1; then
        $SUDO fuser -k 8888/tcp 2>/dev/null || true
        sleep 1
      else
        PID8K=$(ss -tlnp 2>/dev/null | grep ":8888 " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
        [ -n "$PID8K" ] && $SUDO kill "$PID8K" 2>/dev/null || true
        sleep 1
      fi
      ok "Port 8888 freed."
    else
      fail "Exiting — port is busy."
      exit 1
    fi
  fi
fi
ok "Port 8888 is free."

# ---------- 10. Start server ----------
step "Starting REDFORGE C2 server..."
nohup python3 server.py > logs/server.log 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" > logs/server.pid

for i in $(seq 1 20); do
  if curl -fsS -o /dev/null "http://127.0.0.1:8888/" 2>/dev/null; then
    ok "Server is up (PID $SERVER_PID)."
    break
  fi
  sleep 0.5
  if [ "$i" = "20" ]; then
    fail "Server did not start. Check logs/server.log"
    exit 1
  fi
done

# ---------- 11. Start tunnel ----------
step "Starting Cloudflare tunnel..."
: > logs/tunnel.log
nohup cloudflared tunnel --url http://localhost:8888 --no-autoupdate \
  > logs/tunnel.log 2>&1 &
TUNNEL_PID=$!
echo "$TUNNEL_PID" > logs/tunnel.pid

step "Waiting for tunnel URL..."
TUNNEL_URL=""
for i in $(seq 1 30); do
  TUNNEL_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' logs/tunnel.log 2>/dev/null | head -1)
  [ -n "$TUNNEL_URL" ] && break
  sleep 1
done

# ---------- 12. Summary ----------
echo ""
echo -e "${G}════════════════════════════════════════════════════════════════${D}"
if [ -n "$TUNNEL_URL" ]; then
  echo -e "${G}  ✅  REDFORGE is running.${D}"
  echo -e "${G}════════════════════════════════════════════════════════════════${D}"
  echo ""
  echo -e "  Local dashboard   : ${B}http://localhost:8888/${D}"
  echo -e "  Public tunnel URL : ${B}${TUNNEL_URL}${D}"
  echo -e "  Server PID        : ${SERVER_PID}"
  echo -e "  Tunnel PID        : ${TUNNEL_PID}"
  echo -e "  Server log        : logs/server.log"
  echo -e "  Tunnel log        : logs/tunnel.log"
  echo ""
  echo -e "  ${Y}Next steps:${D}"
  echo -e "  1. Open the public URL in a browser."
  echo -e "  2. Go to ${BOLD}PowerShell Agent${D} tab → copy a one-liner."
  echo -e "  3. Send it to your lab partner (who owns the target VM)."
  echo -e "  4. Use the ${BOLD}MSF Console${D} tab for your listener."
  echo ""
  echo -e "  ${R}Stop:${D}    ./rfg stop"
  echo -e "  ${R}Status:${D}  ./rfg status"
else
  echo -e "${Y}  ⚠  Server started, but tunnel URL not detected yet.${D}"
  echo -e "${G}════════════════════════════════════════════════════════════════${D}"
  echo ""
  echo -e "  Check logs/tunnel.log — URL usually appears within 30s."
  echo -e "  Local dashboard : ${B}http://localhost:8888/${D}"
  echo -e "  Stop:   ./rfg stop"
  echo -e "  Status: ./rfg status"
fi
